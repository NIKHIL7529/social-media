{
  "kind": "Deployment",
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "web",
            "image": "socialsphere-web:0.1.0",
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 3000
              }
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/",
                "port": 3000
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "512Mi"
              }
            },
            "securityContext": {
              "runAsNonRoot": true,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": ["ALL"]
              }
            }
          }
        ]
      }
    }
  }
}
